rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // servers/{slug}: name, slug, ownerUid, visibility, description, createdAt
    // targets: name, category, address, specialties, lat, lon, note, createdBy, createdAt
    // user server index: role, addedAt, optional inviteId
    function signedIn(){return request.auth != null;}
    function path(slug){return /databases/$(database)/documents/servers/$(slug);}
    function existsServer(slug){return exists(path(slug));}
    function owner(slug){return signedIn() && existsServer(slug) && get(path(slug)).data.ownerUid==request.auth.uid;}
    function member(slug){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/servers/$(slug));}
    function short(v,min,max){return v is string && v.size()>=min && v.size()<=max;}
    function validServer(d,slug){return d.keys().hasOnly(['name','slug','ownerUid','visibility','description','createdAt']) && d.keys().hasAll(['name','slug','ownerUid','visibility','description','createdAt']) && short(d.name,1,60) && d.slug==slug && slug.matches('^[a-z0-9-]{2,32}$') && d.ownerUid==request.auth.uid && d.visibility in ['private','public'] && short(d.description,0,240) && d.createdAt is timestamp;}
    function validTarget(d){return d.keys().hasOnly(['name','category','address','specialties','lat','lon','note','createdBy','createdAt']) && d.keys().hasAll(['name','category','address','specialties','lat','lon','note','createdBy','createdAt']) && short(d.name,1,100) && d.category in ['ZNA','Dialyse','Wachen','Weitere'] && short(d.address,1,180) && d.specialties is list && d.specialties.size()<=20 && d.lat is number && d.lat>=-90 && d.lat<=90 && d.lon is number && d.lon>=-180 && d.lon<=180 && short(d.note,0,300) && d.createdBy==request.auth.uid && d.createdAt is timestamp;}
    function validIndex(d){return d.keys().hasOnly(['role','addedAt','inviteId']) && d.keys().hasAll(['role','addedAt']) && d.role in ['owner','member'] && d.addedAt is timestamp && (!('inviteId' in d)||short(d.inviteId,1,128));}
    match /servers/{slug}{
      allow get: if (signedIn() && !existsServer(slug)) || (existsServer(slug) && (resource.data.visibility=='public'||member(slug)));
      allow list: if signedIn() && resource.data.visibility=='public';
      allow create: if signedIn() && !existsServer(slug) && validServer(request.resource.data,slug);
      allow update: if owner(slug) && validServer(request.resource.data,slug) && request.resource.data.ownerUid==resource.data.ownerUid && request.resource.data.slug==resource.data.slug && request.resource.data.createdAt==resource.data.createdAt;
      allow delete: if owner(slug);
      match /members/{uid}{
        allow read: if owner(slug)||(signedIn()&&request.auth.uid==uid);
        allow create: if signedIn()&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['role','addedAt'])&&request.resource.data.keys().hasAll(['role','addedAt'])&&request.resource.data.role in ['owner','member']&&request.resource.data.addedAt is timestamp&&((request.resource.data.role=='owner'&&getAfter(path(slug)).data.ownerUid==request.auth.uid)||(request.resource.data.role=='member'&&existsServer(slug)&&get(path(slug)).data.visibility=='public'));
        allow update: if false;
        allow delete: if owner(slug)||(signedIn()&&request.auth.uid==uid);
      }
      match /targets/{id}{
        allow read: if existsServer(slug) && (get(path(slug)).data.visibility=='public'||member(slug));
        allow create: if owner(slug)&&validTarget(request.resource.data);
        allow update: if owner(slug)&&validTarget(request.resource.data)&&request.resource.data.createdBy==resource.data.createdBy&&request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if owner(slug);
      }
      match /invitations/{id}{
        allow read: if owner(slug)||(signedIn()&&resource.data.targetEmail==request.auth.token.email);
        allow create: if owner(slug)&&request.resource.data.keys().hasOnly(['targetEmail','status','role','createdBy','createdAt'])&&request.resource.data.keys().hasAll(['targetEmail','status','role','createdBy','createdAt'])&&short(request.resource.data.targetEmail,3,254)&&request.resource.data.status=='pending'&&request.resource.data.role=='member'&&request.resource.data.createdBy==request.auth.uid&&request.resource.data.createdAt is timestamp;
        allow update: if signedIn()&&resource.data.targetEmail==request.auth.token.email&&resource.data.status=='pending'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt'])&&request.resource.data.status=='accepted'&&request.resource.data.acceptedAt is timestamp&&existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/servers/$(slug));
        allow delete: if owner(slug);
      }
    }
    match /users/{uid}/servers/{slug}{
      allow read: if signedIn()&&request.auth.uid==uid;
      allow create: if signedIn()&&request.auth.uid==uid&&validIndex(request.resource.data)&&existsAfter(/databases/$(database)/documents/servers/$(slug)/members/$(uid))&&((request.resource.data.role=='owner'&&getAfter(path(slug)).data.ownerUid==request.auth.uid)||(request.resource.data.role=='member'&&existsServer(slug)&&get(path(slug)).data.visibility=='public'));
      allow update: if false;
      allow delete: if signedIn()&&request.auth.uid==uid;
    }
    match /{document=**}{allow read,write: if false;}
  }
}