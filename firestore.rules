rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Test phase: the dashboard itself requires a verified e-mail address.
    // Firestore requires an authenticated caller because the email_verified
    // token claim is not reliably refreshed in this test setup.
    function verified() { return signedIn(); }
    function member(slug) {
      return verified() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/servers/$(slug));
    }
    function owner(slug) {
      return verified() &&
        get(/databases/$(database)/documents/servers/$(slug)).data.ownerUid == request.auth.uid;
    }

    match /servers/{slug} {
      allow get: if resource.data.visibility == 'public' || member(slug);
      allow list: if resource.data.visibility == 'public' || member(slug);
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['name','slug','ownerUid','visibility','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9-]{2,32}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['private','public'];
      allow update: if owner(slug)
        && request.resource.data.keys().hasOnly(['name','slug','ownerUid','visibility','createdAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.visibility in ['private','public'];
      allow delete: if owner(slug);

      match /invitations/{inviteId} {
        function inviteIsRecipient() {
          return verified() && resource.data.targetEmail == request.auth.token.email;
        }
        allow get, list: if owner(slug) || inviteIsRecipient();
        allow create: if owner(slug)
          && request.resource.data.keys().hasOnly(['targetEmail','status','role','createdBy','createdAt'])
          && request.resource.data.targetEmail is string
          && request.resource.data.targetEmail.size() <= 254
          && request.resource.data.status == 'pending'
          && request.resource.data.role == 'member'
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if inviteIsRecipient()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt'])
          && request.resource.data.status == 'accepted'
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/servers/$(slug));
        allow delete: if owner(slug);
      }

      match /targets/{targetId} {
        allow get, list: if get(/databases/$(database)/documents/servers/$(slug)).data.visibility == 'public' || member(slug);
        allow create: if member(slug) && owner(slug)
          && request.resource.data.keys().hasOnly(['name','category','address','note','createdBy','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.category is string
          && request.resource.data.address is string
          && request.resource.data.note is string
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if owner(slug);
      }
    }

    match /users/{uid}/servers/{slug} {
      allow get, list: if verified() && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','addedAt','inviteId'])
        && request.resource.data.role in ['owner','member']
        && (
          (request.resource.data.role == 'owner' && verified() && getAfter(/databases/$(database)/documents/servers/$(slug)).data.ownerUid == request.auth.uid)
          || (request.resource.data.role == 'member'
            && get(/databases/$(database)/documents/servers/$(slug)).data.visibility == 'public')
          || (request.resource.data.role == 'member' && request.resource.data.inviteId is string
            && get(/databases/$(database)/documents/servers/$(slug)/invitations/$(request.resource.data.inviteId)).data.targetEmail == request.auth.token.email
            && get(/databases/$(database)/documents/servers/$(slug)/invitations/$(request.resource.data.inviteId)).data.status == 'pending')
        );
      allow update: if verified() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','addedAt'])
        && resource.data.role == 'member' && request.resource.data.role == 'member';
      allow delete: if verified() && request.auth.uid == uid && resource.data.role == 'member';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}